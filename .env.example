# Copy to .env and fill in. Values come from the Supabase dashboard.
# .env is gitignored — never commit real credentials to this public repo.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PROJECT_REF=YOUR-PROJECT-REF

# Not a secret: this key also ships inside join.html. RLS limits it to
# INSERT on members plus the heartbeat() RPC.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

SUPABASE_DB_PASSWORD=

# The dashboard's direct connection string is IPv6-only. If your network has
# no IPv6, use the session pooler instead (Dashboard -> Connect -> Session
# pooler), which looks like:
#   postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# Any random string; Vercel sends it as a Bearer token to /api/keepalive.
CRON_SECRET=
